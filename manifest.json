{
    "manifest_version": 3,
    "name": "Recipe Checker",
    "version": "1.0",

    "permissions": [
        "activeTab",
        "scripting"
    ],

    "action": {
        "default_popup": "popup.html",
        "default_icon": {
        "128": "img/icon128.png"
        }
    },

    "icons": {
        "128": "img/icon128.png"
    },

    "content_scripts": [
        {
            "matches": [
                "https://xtrickster.com/*"
            ],
            "js": [
                "popup.js"
            ],
            "css": [
                "styles.css"
            ]
        }
    ]
}